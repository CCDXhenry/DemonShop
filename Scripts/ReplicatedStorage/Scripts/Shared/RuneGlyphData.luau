-- 符文字形 64×64 透明度数据：由 AI 生成的透明 PNG 离线导出，供曲面图集与平面 EditableImage 共用
--!strict
local RuneGlyphData = {}
RuneGlyphData.Size = 64
RuneGlyphData.Count = 3

local ENCODED: { string } = {
	"",
	"",
	"",
}

local ALPHABET = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local DECODE_MAP: { [number]: number } = {}
for i = 1, #ALPHABET do
	DECODE_MAP[string.byte(ALPHABET, i)] = i - 1
end

local function DecodeBase64(text: string, expectedBytes: number): buffer
	local out = buffer.create(expectedBytes)
	local write = 0
	local length = #text
	local i = 1
	while i <= length and write < expectedBytes do
		local c1 = DECODE_MAP[string.byte(text, i)] or 0
		local c2 = DECODE_MAP[string.byte(text, i + 1)] or 0
		local b3 = string.byte(text, i + 2)
		local b4 = string.byte(text, i + 3)
		local c3 = if b3 then DECODE_MAP[b3] else nil
		local c4 = if b4 then DECODE_MAP[b4] else nil
		local n = bit32.bor(bit32.lshift(c1, 18), bit32.lshift(c2, 12), bit32.lshift(c3 or 0, 6), c4 or 0)
		buffer.writeu8(out, write, bit32.band(bit32.rshift(n, 16), 255))
		write += 1
		if c3 ~= nil and write < expectedBytes then
			buffer.writeu8(out, write, bit32.band(bit32.rshift(n, 8), 255))
			write += 1
		end
		if c4 ~= nil and write < expectedBytes then
			buffer.writeu8(out, write, bit32.band(n, 255))
			write += 1
		end
		i += 4
	end
	return out
end

-- 启动期 3×3 柔化膨胀加粗与透明度提浓，使 64×64 字形在 3D 曲面图集上笔画更清晰饱满，运行期零额外开销。
local function BoldenGlyph(source: buffer, size: number): buffer
	local out = buffer.create(size * size)
	for y = 0, size - 1 do
		local row = y * size
		for x = 0, size - 1 do
			local best = buffer.readu8(source, row + x)
			for dy = -1, 1 do
				local ny = y + dy
				if ny < 0 or ny >= size then
					continue
				end
				local nRow = ny * size
				for dx = -1, 1 do
					if dx == 0 and dy == 0 then
						continue
					end
					local nx = x + dx
					if nx < 0 or nx >= size then
						continue
					end
					local weight = if dx == 0 or dy == 0 then 0.90 else 0.68
					local candidate = math.floor(buffer.readu8(source, nRow + nx) * weight + 0.5)
					if candidate > best then
						best = candidate
					end
				end
			end
			if best > 0 then
				best = math.min(255, math.floor(best * 1.18 + 0.5))
			end
			buffer.writeu8(out, row + x, best)
		end
	end
	return out
end

local GLYPHS: { buffer } = {}
local PIXEL_COUNT = RuneGlyphData.Size * RuneGlyphData.Size
for index, text in ipairs(ENCODED) do
	GLYPHS[index] = BoldenGlyph(DecodeBase64(text, PIXEL_COUNT), RuneGlyphData.Size)
end

function RuneGlyphData.Alpha(glyph: number): buffer
	return GLYPHS[glyph] or GLYPHS[1]
end

function RuneGlyphData.Sample(glyph: number, u: number, v: number): number
	if u <= 0 or u >= 1 or v <= 0 or v >= 1 then
		return 0
	end
	local alpha = GLYPHS[glyph] or GLYPHS[1]
	local size = RuneGlyphData.Size
	local fx = u * size - 0.5
	local fy = v * size - 0.5
	local x0 = math.floor(fx)
	local y0 = math.floor(fy)
	local tx = fx - x0
	local ty = fy - y0
	local x1 = x0 + 1
	local y1 = y0 + 1
	local a00 = if x0 >= 0 and x0 < size and y0 >= 0 and y0 < size then buffer.readu8(alpha, y0 * size + x0) else 0
	local a10 = if x1 >= 0 and x1 < size and y0 >= 0 and y0 < size then buffer.readu8(alpha, y0 * size + x1) else 0
	local a01 = if x0 >= 0 and x0 < size and y1 >= 0 and y1 < size then buffer.readu8(alpha, y1 * size + x0) else 0
	local a11 = if x1 >= 0 and x1 < size and y1 >= 0 and y1 < size then buffer.readu8(alpha, y1 * size + x1) else 0
	local top = a00 + (a10 - a00) * tx
	local bottom = a01 + (a11 - a01) * tx
	return top + (bottom - top) * ty
end

function RuneGlyphData.CreateRgbaBuffer(glyph: number): buffer
	local alpha = GLYPHS[glyph] or GLYPHS[1]
	local pixels = buffer.create(PIXEL_COUNT * 4)
	buffer.fill(pixels, 0, 255)
	for index = 0, PIXEL_COUNT - 1 do
		buffer.writeu8(pixels, index * 4 + 3, buffer.readu8(alpha, index))
	end
	return pixels
end

return RuneGlyphData
